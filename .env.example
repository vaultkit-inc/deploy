# Copy this file to .env and fill in the values.
# Do NOT commit your real .env file.

# The release to run. All three VaultKit images use it. An install keeps this
# version until you change it with ./scripts/install.sh --version <version>.
VAULTKIT_VERSION=0.9.2-alpha

# Database
POSTGRES_USER=vaultkit
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=vaultkit
# Keep POSTGRES_PASSWORD in sync with the password above
DATABASE_URL=postgres://vaultkit:<choose-a-strong-password>@postgres:5432/vaultkit

# Application
RAILS_ENV=production

# Public URL where VaultKit will be accessed.
# This is always the Console URL (the single entry point).
#
# Option A — Local machine:
#   APP_HOST=http://localhost:5173
#
# Option B — Remote VM or EC2 (no domain):
#   APP_HOST=http://<your-server-ip>:5173
#
# Option C — Custom domain:
#   APP_HOST=https://vaultkit.yourdomain.com
#
APP_HOST=<your-vaultkit-url>

# The control plane redirects anything that isn't HTTPS. For Options A and B,
# which use plain HTTP, also set:
# FORCE_SSL=false

# Behind a reverse proxy on this host, bind the console to localhost so only the
# proxy can reach it.
# CONSOLE_BIND=127.0.0.1

# Secrets (auto-generated by install.sh)
# Do not set these manually unless you have a specific reason to.
SECRET_KEY_BASE=change-me
JWT_SECRET=change-me
VAULTKIT_ENCRYPTION_KEY=change-me

# Internal services
# The control plane reaches funl here (it is not published to the host), and
# the console's system status probes FUNL_URL/health. Keep it set.
FUNL_URL=http://funl-runtime:8080

# Funl query limits (optional; defaults shown). One funl serves every
# organization, so these keep one organization from starving the others.
# FUNL_MAX_CONCURRENT_QUERIES=50          # running queries across all orgs
# FUNL_MAX_CONCURRENT_QUERIES_PER_ORG=10  # running queries per org
# FUNL_QUERY_WAIT=2s                      # wait for a free slot before 429/503
# FUNL_QUERY_TIMEOUT=20s                  # per-query timeout (then 504)

VKIT_PRIVATE_KEY=/secrets/keys/vkit_priv.pem
VKIT_PUBLIC_KEY=/secrets/keys/vkit_pub.pem

# OIDC / SSO (optional)
# OIDC_ENABLED=false turns SSO off everywhere: browser sign-in, organization
# activation and `vkit login`. Email-and-password organizations and agent
# tokens work without it, so leave it false for an initial evaluation.
# Set OIDC_ENABLED=true and the values below when you are ready for SSO.
# One identity provider (OIDC_ISSUER) serves the whole control plane.
OIDC_ENABLED=false
OIDC_DEV_STUB=false
OIDC_ISSUER=<your-oidc-issuer-url>
OIDC_CLIENT_ID=<your-client-id>
OIDC_CLIENT_SECRET=<your-client-secret>

# Must match APP_HOST with /auth/oidc/callback appended
OIDC_REDIRECT_URI=<your-vaultkit-url>/auth/oidc/callback

# Frontend
# Always the same as APP_HOST
FRONTEND_BASE_URL=<your-vaultkit-url>
