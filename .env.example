# Copy this file to .env and fill in the values.
# Do NOT commit your real .env file.

# Database connection used by VaultKit
POSTGRES_USER=vaultkit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vaultkit
DATABASE_URL=postgres://vaultkit:changeme@postgres:5432/vaultkit

# Application environment
RAILS_ENV=production

# Public URL where VaultKit will be accessed
# Example: https://alpha.vaultkit.io
APP_HOST=https://your-domain.com

# Required secrets (generate strong random values)
# Used for cookies, sessions, and token signing
SECRET_KEY_BASE=change-me
JWT_SECRET=change-me
VAULTKIT_ENCRYPTION_KEY=change-me

# Internal Funl runtime URL (Docker service name)
FUNL_URL=http://funl-runtime:8080

# Signing keys mounted into the containers
VKIT_PRIVATE_KEY=/secrets/keys/vkit_priv.pem
VKIT_PUBLIC_KEY=/secrets/keys/vkit_pub.pem

# OIDC authentication settings
OIDC_ENABLED=true
OIDC_DEV_STUB=false
OIDC_ISSUER=https://your-okta-domain/oauth2/default
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Must match APP_HOST
OIDC_REDIRECT_URI=https://your-domain.com/auth/oidc/callback

# Public URL of the VaultKit console
# Usually the same as APP_HOST
# Also used for OpenGraph/social media meta tags
FRONTEND_BASE_URL=https://your-domain.com
